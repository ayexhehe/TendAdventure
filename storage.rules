rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /merchants/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /activities/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /about/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
