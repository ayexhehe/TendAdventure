rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /merchants/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /activities/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /about/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin-only, unlike the other upload paths above (which allow any
    // signed-in user — a pre-existing, broader pattern left as-is here).
    // Performer photos are tied to a live vote, so this path is tightened
    // deliberately: cross-references the same admin allowlist Firestore
    // rules use, via Storage's cross-service firestore.get().
    match /votingPerformers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in
           firestore.get(/databases/(default)/documents/config/adminEmails).data.emails;
    }
  }
}
