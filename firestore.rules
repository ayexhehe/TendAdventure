rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower()
           in get(/databases/$(database)/documents/config/adminEmails).data.emails;
    }

    match /config/adminEmails {
      allow read, write: if isAdminEmail();
    }

    match /config/about {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /config/quizBowlSettings {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /config/taskedSettings {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /config/gameSettings {
      allow read: if true;
      allow write: if isAdminEmail();

      // Coupon-award transaction: any signed-in winner may bump their
      // game's public issued-ticket counter by exactly 1 — nothing else
      // about game settings can move through these two rules.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quizBowlTicketsIssued'])
        && request.resource.data.quizBowlTicketsIssued == resource.data.quizBowlTicketsIssued + 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taskedTicketsIssued'])
        && request.resource.data.taskedTicketsIssued == resource.data.taskedTicketsIssued + 1;
    }

    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if isAdminEmail();

      // Coupon-award transaction: any signed-in winner may claim one
      // coupon slot for themselves by incrementing couponsIssued by
      // exactly 1, and only up to the admin-set couponSupply cap.
      // Nothing else about the merchant can move through this rule.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['couponsIssued'])
        && request.resource.data.couponsIssued == resource.data.couponsIssued + 1
        && request.resource.data.couponsIssued <= resource.data.couponSupply;
    }

    // Each merchant's secret redemption code. Never read directly by
    // players — coupon redemption validates against this via get() in
    // the tindaCoupons update rule below, which bypasses this doc's own
    // read rule entirely (a documented Firestore rules behavior).
    match /merchantCodes/{merchantId} {
      allow read, write: if isAdminEmail();
    }

    match /tindaCoupons/{couponId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow read: if isAdminEmail();

      // Only ever created for yourself, as an unredeemed coupon — the
      // award transaction runs on the winning player's own client.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.redeemed == false
        && request.resource.data.redeemedAt == null;

      // Redeeming: the coupon owner "presents" it and a seller types in
      // their tindahan's code. The write is only allowed through if the
      // entered code actually matches that merchant's real code — the
      // seller never needs an account, and the real code is never
      // exposed to the client for this check to work.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && resource.data.redeemed == false
        && request.resource.data.redeemed == true
        && request.resource.data.redeemedAt is number
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemed', 'redeemedAt', 'redeemedCode'])
        && request.resource.data.redeemedCode ==
           get(/databases/$(database)/documents/merchantCodes/$(resource.data.merchantId)).data.code;

      // Admin-only cleanup — works for both unclaimed and already-claimed
      // coupons. The client always requires a typed "DELETE" confirmation
      // before this fires; this rule is the server-side backstop that
      // only an admin account can ever trigger it at all.
      allow delete: if isAdminEmail();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdminEmail();

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'player'
        && request.resource.data.quizBowl.hasWon == false
        && request.resource.data.quizBowl.wonAt == null
        && request.resource.data.tasked.ticketAwarded == false
        && request.resource.data.tasked.completedAt == null;

      // Players may update their own profile fields, but not the
      // role/game-state fields — those only ever change via the
      // self-promotion rule below, or a manual admin edit.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.quizBowl == resource.data.quizBowl
        && request.resource.data.tasked == resource.data.tasked;

      // Self-promotion: on sign-in, a client whose email is on the
      // admin allowlist may sync its own role to 'admin'. The allowlist
      // itself is never exposed to the client for this check — the
      // comparison happens entirely inside isAdminEmail() at write time.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role == 'admin'
        && isAdminEmail();

      // Quiz Bowl win: a player may record their own win once, going only
      // from not-won to won — never reversing it, never touching anything
      // else on the profile.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quizBowl'])
        && resource.data.quizBowl.hasWon == false
        && request.resource.data.quizBowl.hasWon == true
        && request.resource.data.quizBowl.wonAt is number;

      // Admin Quiz Bowl reset: an admin may reset any player's quizBowl
      // state (e.g. the "reset all players" admin action), touching no
      // other field on their profile.
      allow update: if isAdminEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quizBowl']);

      // taSKed win: a player may record their own ticket award once,
      // going only from not-awarded to awarded — never reversing it,
      // never touching anything else on the profile.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasked'])
        && resource.data.tasked.ticketAwarded == false
        && request.resource.data.tasked.ticketAwarded == true
        && request.resource.data.tasked.completedAt is number;

      // Admin taSKed reset: an admin may reset any player's tasked
      // ticket state (e.g. the "reset all tasks" admin action), touching
      // no other field on their profile.
      allow update: if isAdminEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasked']);
    }

    match /quizBowlAttempts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      // Players may advance their own attempt (index/correctCount/status/
      // finishedAt/cooldownUntil), but the round itself is fixed at
      // creation and can't be swapped mid-quiz.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.round == resource.data.round;

      // Admins can read/reset any player's attempt (cooldown reset,
      // reset-all-players) from the General admin panel.
      allow read, write: if isAdminEmail();
    }

    match /quizBowlSeenQuestions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      // Admins can wipe any player's seen-question history as part of
      // the "reset all players" admin action.
      allow read, write: if isAdminEmail();
    }

    match /taskedEntrants/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdminEmail();

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      // A player advances their own 3 tasks; the personal share slug is
      // fixed at creation and can't be swapped out from under them.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.personalShareSlug == resource.data.personalShareSlug;

      // Admins can reset any player's progress (the "reset all tasks"
      // admin action) — the personal share slug still can't change, so a
      // reset player's existing invite link keeps working.
      allow update: if isAdminEmail()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.personalShareSlug == resource.data.personalShareSlug;
    }

    // Public slug -> uid pointer so an anonymous friend visiting
    // /i/:slug can resolve whose invite link they clicked, without any
    // access to that player's actual progress doc.
    match /taskedSlugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // One doc per logged invite-link click. Writable by anyone (most
    // clickers are friends who aren't signed in yet) — a deliberate,
    // low-stakes trust tradeoff consistent with the rest of this app's
    // game-state writes. Only the owning player (or an admin) can read
    // their own click log back to compute a count.
    match /taskedClickLogs/{clickId} {
      allow create: if request.resource.data.ownerUid is string
        && request.resource.data.visitorId is string
        && request.resource.data.clickedAt is number;
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow read: if isAdminEmail();
      allow update: if false;

      // Only an admin can clear click logs, as part of the "reset all
      // tasks" admin action.
      allow delete: if isAdminEmail();
    }

    match /messageWall/{messageId} {
      // Approved messages are public (the whole point of the wall);
      // a player can always read back their own pending/rejected
      // submission; admins can read everything for moderation.
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.uid)
        || isAdminEmail();

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null;

      // Only an admin can move a message through moderation.
      allow update: if isAdminEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
