rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower()
           in get(/databases/$(database)/documents/config/adminEmails).data.emails;
    }

    match /config/adminEmails {
      allow read, write: if isAdminEmail();
    }

    match /config/about {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /config/quizBowlSettings {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /config/taskedSettings {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /config/gameSettings {
      allow read: if true;
      allow write: if isAdminEmail();

      // Coupon-award transaction: any signed-in winner may bump their
      // game's public issued-ticket counter by exactly 1 — nothing else
      // about game settings can move through this rule. Quiz Bowl has no
      // client-side equivalent: quizBowlTicketsIssued only ever moves via
      // the submitQuizAnswer Cloud Function's Admin SDK, which bypasses
      // rules entirely, because that's also the only place a Quiz Bowl
      // win can be decided.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taskedTicketsIssued'])
        && request.resource.data.taskedTicketsIssued == resource.data.taskedTicketsIssued + 1;

      // Voting tickets are awarded server-side only, by the scheduled
      // Cloud Function using the Admin SDK — which bypasses these rules
      // entirely. No client-side rule grants write access to
      // votingTicketsIssued; the blanket admin `allow write` above is the
      // only client path, for the admin panel's votingWindowMinutes /
      // votingWindowEndsAt (start/stop a round) / votingTicketsTotal fields.
    }

    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if isAdminEmail();

      // Coupon-award transaction: any signed-in winner may claim one
      // coupon slot for themselves by incrementing couponsIssued by
      // exactly 1, and only up to the admin-set couponSupply cap.
      // Nothing else about the merchant can move through this rule.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['couponsIssued'])
        && request.resource.data.couponsIssued == resource.data.couponsIssued + 1
        && request.resource.data.couponsIssued <= resource.data.couponSupply;
    }

    // Each merchant's secret redemption code. Never read directly by
    // players — coupon redemption validates against this via get() in
    // the tindaCoupons update rule below, which bypasses this doc's own
    // read rule entirely (a documented Firestore rules behavior).
    match /merchantCodes/{merchantId} {
      allow read, write: if isAdminEmail();
    }

    // Each merchant's real quiz questionnaire, including correctAnswer.
    // Deliberately kept off the public merchants/{merchantId} doc (which
    // only carries a questionCount) so the answer key is never part of
    // any payload sent to a player's browser. Only the admin Merchants
    // tab (via these rules) and the startQuizAttempt Cloud Function (via
    // the Admin SDK, which bypasses these rules) ever read it.
    match /merchantQuestions/{merchantId} {
      allow read, write: if isAdminEmail();
    }

    match /tindaCoupons/{couponId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow read: if isAdminEmail();

      // Only ever created for yourself, as an unredeemed coupon — the
      // award transaction runs on the winning player's own client. Voting
      // and Quiz Bowl coupons are excluded here on purpose: those are only
      // ever awarded server-side (the scheduled voting Cloud Function and
      // the submitQuizAnswer Cloud Function, respectively — both via the
      // Admin SDK, which bypasses these rules entirely), because deciding
      // a win for either of those games also has to happen server-side.
      // Only taSKed still awards its own coupon directly from the client.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.redeemed == false
        && request.resource.data.redeemedAt == null
        && request.resource.data.source in ['tasked'];

      // Redeeming: the coupon owner "presents" it and a seller types in
      // their tindahan's code. The write is only allowed through if the
      // entered code actually matches that merchant's real code — the
      // seller never needs an account, and the real code is never
      // exposed to the client for this check to work.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && resource.data.redeemed == false
        && request.resource.data.redeemed == true
        && request.resource.data.redeemedAt is number
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemed', 'redeemedAt', 'redeemedCode'])
        && request.resource.data.redeemedCode ==
           get(/databases/$(database)/documents/merchantCodes/$(resource.data.merchantId)).data.code;

      // Admin-only cleanup — works for both unclaimed and already-claimed
      // coupons. The client always requires a typed "DELETE" confirmation
      // before this fires; this rule is the server-side backstop that
      // only an admin account can ever trigger it at all.
      allow delete: if isAdminEmail();
    }

    match /votingCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /votingPerformers/{performerId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    // Live vote tallies. Deliberately its own admin-only collection,
    // separate from the public votingPerformers doc — sealing the ballot
    // so results can never be read by a voter (or anyone with the app's
    // public Firebase config, which is everyone) while a round is live.
    // Written only by the vote-created Cloud Function trigger (Admin SDK,
    // bypasses these rules) — not even an admin client can create/update
    // it. Delete is the one admin escape hatch, for the "reset all votes"
    // admin action (clearing tallies back to zero between rounds/testing).
    match /votingResults/{performerId} {
      allow read: if isAdminEmail();
      allow create, update: if false;
      allow delete: if isAdminEmail();
    }

    // One vote per (voter, category): the doc id is `${uid}_${categoryId}`,
    // so a repeat vote just collides with the existing doc — and a cast
    // vote can never be edited. Everyone votes against the same shared
    // clock — a vote only goes through while `now` is still before the
    // admin-started round's `votingWindowEndsAt` on config/gameSettings.
    match /votes/{voteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow read: if isAdminEmail();

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.categoryId
        && request.resource.data.votedAt is number
        && get(/databases/$(database)/documents/votingPerformers/$(request.resource.data.performerId)).data.categoryId
           == request.resource.data.categoryId
        && get(/databases/$(database)/documents/config/gameSettings).data.votingWindowEndsAt is number
        && request.time.toMillis() <=
           get(/databases/$(database)/documents/config/gameSettings).data.votingWindowEndsAt;

      allow update: if false;

      // Admin-only reset (e.g. "reset all votes" between rounds/testing).
      // A signed-in voter can never delete their own vote — only an admin
      // bulk reset can, and it's a full wipe, not a per-vote takeback.
      allow delete: if isAdminEmail();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdminEmail();

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'player'
        && request.resource.data.quizBowl.hasWon == false
        && request.resource.data.quizBowl.wonAt == null
        && request.resource.data.tasked.ticketAwarded == false
        && request.resource.data.tasked.completedAt == null;

      // Players may update their own profile fields, but not the
      // role/game-state fields — those only ever change via the
      // self-promotion rule below, or a manual admin edit.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.quizBowl == resource.data.quizBowl
        && request.resource.data.tasked == resource.data.tasked;

      // Self-promotion: on sign-in, a client whose email is on the
      // admin allowlist may sync its own role to 'admin'. The allowlist
      // itself is never exposed to the client for this check — the
      // comparison happens entirely inside isAdminEmail() at write time.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role == 'admin'
        && isAdminEmail();

      // Quiz Bowl win: recorded only by the submitQuizAnswer Cloud
      // Function (Admin SDK, which bypasses these rules) — a Quiz Bowl
      // win is decided server-side, so there's no client-side path that
      // should ever be allowed to flip this flag directly.

      // Admin Quiz Bowl reset: an admin may reset any player's quizBowl
      // state (e.g. the "reset all players" admin action), touching no
      // other field on their profile.
      allow update: if isAdminEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quizBowl']);

      // taSKed win: a player may record their own ticket award once,
      // going only from not-awarded to awarded — never reversing it,
      // never touching anything else on the profile.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasked'])
        && resource.data.tasked.ticketAwarded == false
        && request.resource.data.tasked.ticketAwarded == true
        && request.resource.data.tasked.completedAt is number;

      // Admin taSKed reset: an admin may reset any player's tasked
      // ticket state (e.g. the "reset all tasks" admin action), touching
      // no other field on their profile.
      allow update: if isAdminEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasked']);

      // Admin-only profile reset (Users tab "Delete" action). A player
      // can never delete their own doc — only an admin bulk-reset can,
      // and it only removes the profile doc itself, not their auth
      // account or any other collection.
      allow delete: if isAdminEmail();
    }

    match /quizBowlAttempts/{uid} {
      // Read-only for the owning player — every write (starting a round,
      // grading an answer, finishing with a win or loss) happens
      // server-side in the startQuizAttempt / submitQuizAnswer Cloud
      // Functions via the Admin SDK, which bypasses these rules. That's
      // deliberate: it's what makes it impossible for a client to
      // self-declare a win or advance past a question it hasn't actually
      // answered correctly.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Admins can read/reset any player's attempt (cooldown reset,
      // reset-all-players) from the General admin panel.
      allow read, write: if isAdminEmail();
    }

    // The answer key for a player's current round (see
    // QuizBowlAttemptSecretDoc). No rule here grants any client access at
    // all, not even the owning player or an admin — the catch-all at the
    // bottom of this file denies it by default, which is exactly the
    // point: the only way to ever read this collection is the Admin SDK
    // inside the grading Cloud Function.
    match /quizBowlAttemptSecrets/{uid} {
      allow read, write: if false;
    }

    match /quizBowlSeenQuestions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      // Admins can wipe any player's seen-question history as part of
      // the "reset all players" admin action.
      allow read, write: if isAdminEmail();
    }

    match /taskedEntrants/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdminEmail();

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      // taSKed is the only game left that decides a win client-side (Quiz
      // Bowl and Voting both moved server-side), so unlike those, each
      // task's completion has to be locked down field-by-field here
      // instead of trusting a broad self-update — otherwise a player could
      // just set task1CompletedAt (etc.) to anything directly, skipping
      // the actual task entirely. Each rule below only allows moving that
      // one task from not-completed to completed, together with its
      // supporting field, and nothing else.

      // Task 1: only once the reported click count actually meets the
      // real target (3) — doesn't verify the underlying clicks are
      // genuine (see taskedClickLogs below for that), just that this
      // specific write can't claim completion without at least reporting
      // a plausible count.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['task1ClickCount', 'task1CompletedAt'])
        && resource.data.task1CompletedAt == null
        && request.resource.data.task1CompletedAt is number
        && request.resource.data.task1ClickCount >= 3;

      // Task 2: only once, with a real (non-empty) link recorded.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['task2PostLink', 'task2CompletedAt'])
        && resource.data.task2CompletedAt == null
        && request.resource.data.task2CompletedAt is number
        && request.resource.data.task2PostLink is string
        && request.resource.data.task2PostLink.size() > 0;

      // Task 3: only once, referencing a real messageWall doc id.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['task3MessageId', 'task3CompletedAt'])
        && resource.data.task3CompletedAt == null
        && request.resource.data.task3CompletedAt is number
        && request.resource.data.task3MessageId is string
        && request.resource.data.task3MessageId.size() > 0;

      // All three done: only once every individual task is already
      // recorded as completed, and only this one field moves.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allTasksCompletedAt'])
        && resource.data.allTasksCompletedAt == null
        && request.resource.data.allTasksCompletedAt is number
        && resource.data.task1CompletedAt is number
        && resource.data.task2CompletedAt is number
        && resource.data.task3CompletedAt is number;

      // Coupon-award idempotency lock — flipped atomically alongside
      // creating the tindaCoupons doc, inside the same client transaction
      // (see lib/tindaCoupons.ts's awardTindaCoupon). Never reversible by
      // a player; only an admin coupon delete releases it (below). Reads
      // the current value via get(key, default) rather than dot-access —
      // entrants created before this field existed have no couponAwarded
      // key at all, and dot-accessing a missing map key errors out the
      // whole rule (denying the request) instead of just being falsy.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['couponAwarded'])
        && resource.data.get('couponAwarded', false) == false
        && request.resource.data.couponAwarded == true;

      // Admins can reset any player's progress (the "reset all tasks"
      // admin action), or release the coupon lock after deleting an
      // erroneous coupon — the personal share slug still can't change, so
      // a reset player's existing invite link keeps working.
      allow update: if isAdminEmail()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.personalShareSlug == resource.data.personalShareSlug;
    }

    // Public slug -> uid pointer so an anonymous friend visiting
    // /i/:slug can resolve whose invite link they clicked, without any
    // access to that player's actual progress doc.
    match /taskedSlugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // One doc per (owner, real visitor account) pair, doc id
    // `${ownerUid}_${visitorId}` — that deterministic id, combined with
    // update being fully disallowed, is what makes a click only ever
    // countable once per real signed-in visitor: a repeat click just
    // collides with the existing doc. Requiring the clicker to be signed
    // in (rather than accepting any anonymous write with a client-picked
    // id) is what stops a player from scripting up "3 friends" out of
    // thin air. Only the owning player (or an admin) can read their own
    // click log back to compute a count.
    match /taskedClickLogs/{clickId} {
      allow create: if request.auth != null
        && clickId == request.resource.data.ownerUid + '_' + request.auth.uid
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.clickedAt is number;
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow read: if isAdminEmail();
      allow update: if false;

      // Only an admin can clear click logs, as part of the "reset all
      // tasks" admin action.
      allow delete: if isAdminEmail();
    }

    match /messageWall/{messageId} {
      // Approved messages are public (the whole point of the wall);
      // a player can always read back their own pending/rejected
      // submission; admins can read everything for moderation.
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.uid)
        || isAdminEmail();

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null;

      // Only an admin can move a message through moderation.
      allow update: if isAdminEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
